{
  "name": "celld-local-chat",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "pretypecheck": "node scripts/write-build-info.mjs",
    "prebuild": "node scripts/write-build-info.mjs",
    "dev": "nuxt dev",
    "build": "node scripts/copy-realtimekit.mjs && nuxt generate && node scripts/build-pwa.mjs && node scripts/bundle-migrations.mjs && node scripts/build-contract.mjs && node scripts/build-worker.mjs",
    "db:generate": "drizzle-kit generate && node scripts/bundle-migrations.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.worker.json",
    "types": "wrangler types worker-env.d.ts --config wrangler.cloudflare.jsonc --strict-vars false",
    "test:smoke": "node scripts/smoke.mjs",
    "test:contract": "node scripts/build-contract.mjs && node scripts/test-contract.mjs",
    "test:drafts": "node scripts/test-drafts.mjs",
    "test:messages": "node scripts/test-messages.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:connections": "node scripts/test-connections.mjs",
    "test:servers": "node scripts/test-server-list.mjs",
    "test:viewport": "node scripts/test-mobile-viewport.mjs",
    "verify": "npm run typecheck && npm run test:contract && npm run test:drafts && npm run test:messages && npm run test:connections && npm run test:servers && node scripts/test-navigation.mjs && npm run test:viewport && npm run build && npm run test:pwa",
    "prepare:cloudflare": "npm run build && node scripts/prepare-cloudflare-config.mjs",
    "release:package": "node scripts/package-release.mjs",
    "test:pwa": "node scripts/test-pwa.mjs"
  },
  "dependencies": {
    "@cloudflare/realtimekit": "2.0.3",
    "@cloudflare/realtimekit-ui": "2.0.3",
    "@nuxt/ui": "4.11.3",
    "@tanstack/db": "0.14.0",
    "@tanstack/query-db-collection": "1.4.4",
    "@tanstack/vue-db": "0.3.9",
    "@tanstack/vue-query": "5.104.2",
    "@vueuse/core": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "nuxt": "4.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@iconify-json/lucide": "^1.2.100",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.27.7",
    "typescript": "^5.9.3",
    "vue-tsc": "3.3.13",
    "wrangler": "4.151.0",
    "ws": "8.22.0"
  }
}
